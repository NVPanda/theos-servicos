# =========================================================
#  .gitignore — Theos Serviços / esboço de sites estáticos
#  Ordem: SO > editores > segredos > logs > temporários >
#         dependências > caches > build > frameworks > testes
# =========================================================

# ---------- Sistema operacional ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- Editores e IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# ---------- Ambientes e segredos ----------
.env
.env.*
!.env.example

# ---------- Logs e diagnósticos ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.pid.lock

# ---------- Temporários ----------
*.tmp
*.bak
*.orig
~$*

# ---------- Dependências (Node) ----------
# ATENÇÃO: os lockfiles NÃO são ignorados de propósito.
node_modules/
bower_components/
jspm_packages/
web_modules/

# ---------- Caches de ferramentas ----------
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tsbuildinfo
.pnpm-store/
.parcel-cache/
.cache/
.grunt
.lock-wscript

# ---------- Build e saída ----------
dist/
build/
out/
.output

# ---------- Frameworks (apague o que não usar) ----------
.next
.nuxt
.cache/
.docusaurus
.vuepress/dist
.vuepress/.temp
.svelte-kit/
.astro/
.vitepress/cache
.turbo
.serverless/
.fusebox/
.dynamodb/
.firebase/
.vite/

# ---------- Testes e cobertura ----------
coverage
*.lcov
.nyc_output
lib-cov

# ---------- pnpm / Yarn Berry ----------
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# ---------- Extensões / empacotamento ----------
*.tgz
.tern-port
.vscode-test
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
